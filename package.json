{
  "name": "dsh-gameflow",
  "version": "0.0.1",
  "description": "门后 — 右下角一扇安静的小木门，点开是一间屋子。你在这一头干活，他在那一头过日子，用的是同一个下午。零打扰、零压力、纯陪伴。",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "preview.html",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "preview": "node scripts/preview.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "look": "node scripts/look.mjs",
    "test": "node scripts/build-client.mjs && node scripts/smoke.mjs",
    "verify": "node scripts/verify-packs.mjs && node scripts/verify-rules.mjs",
    "e2e": "node scripts/e2e.mjs",
    "prepublishOnly": "node scripts/build-client.mjs && node scripts/smoke.mjs && node scripts/verify-packs.mjs && node scripts/verify-rules.mjs && node scripts/e2e.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1,
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "companion",
    "gameflow",
    "门后"
  ],
  "publishConfig": {
    "access": "public"
  }
}
